{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "rootDir": "..",
    "outDir": "../.devout",
    "noEmit": false,
    "noCheck": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "types": []
  },
  "include": ["../src/engine/*.ts", "./*.ts"]
}
